<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VoiceDiary.Views.LockScreenOverlay">
    
    <Frame BackgroundColor="#CC000000"
           HasShadow="True"
           IsClippedToBounds="True"
           HorizontalOptions="Fill"
           VerticalOptions="Fill"
           Padding="0"
           IsVisible="{Binding IsLockScreenVisible}">
        
        <VerticalStackLayout HorizontalOptions="Center"
                           VerticalOptions="Center"
                           Spacing="30"
                           Padding="30">
            
            <!-- 锁图标 -->
            <Label Text="🔒"
                   FontSize="80"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"/>
            
            <!-- 标题 -->
            <Label Text="需要验证身份"
                   FontSize="24"
                   FontAttributes="Bold"
                   TextColor="White"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"/>
            
            <!-- 说明文字 -->
            <Label Text="请使用生物识别验证以访问应用"
                   FontSize="16"
                   TextColor="#CCCCCC"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"/>
            
            <!-- 验证按钮 -->
            <Button Text="验证身份"
                    BackgroundColor="#007AFF"
                    TextColor="White"
                    FontSize="16"
                    WidthRequest="250"
                    HeightRequest="55"
                    CornerRadius="27"
                    HorizontalOptions="Center"
                    Command="{Binding AuthenticateCommand}"
                    IsEnabled="{Binding IsNotAuthenticating}"/>
            
            <!-- 取消按钮（可选） -->
            <Button Text="稍后再说"
                    BackgroundColor="Transparent"
                    TextColor="#CCCCCC"
                    FontSize="14"
                    HorizontalOptions="Center"
                    Command="{Binding CancelCommand}"
                    IsVisible="{Binding CanCancel}"/>
            
            <!-- 加载指示器 -->
            <ActivityIndicator IsRunning="{Binding IsAuthenticating}"
                               IsVisible="{Binding IsAuthenticating}"
                               Color="White"
                               HorizontalOptions="Center"
                               WidthRequest="40"
                               HeightRequest="40"/>
            
        </VerticalStackLayout>
        
    </Frame>
</ContentView>
