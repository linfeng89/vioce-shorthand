<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VoiceDiary.Views.SearchPage"
             Title="搜索">

    <Grid RowDefinitions="Auto,*">
        <!-- 搜索栏 -->
        <Frame Grid.Row="0" Padding="10" Margin="10" HasShadow="True">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <Entry Grid.Column="0"
                       Text="{Binding SearchQuery, UpdateSourceEventName=TextChanged}"
                       Placeholder="搜索日记内容..."
                       x:Name="SearchEntry"
                       VerticalOptions="Center"/>
                
                <Button Grid.Column="1"
                        Text="搜索"
                        Command="{Binding SearchCommand}"
                        BackgroundColor="#007AFF"
                        TextColor="White"
                        Padding="20,10"
                        VerticalOptions="Center"/>
                
                <Button Grid.Column="1"
                        Text="清空"
                        Command="{Binding ClearSearchCommand}"
                        BackgroundColor="#8E8E93"
                        TextColor="White"
                        Padding="20,10"
                        VerticalOptions="Center"
                        IsVisible="{Binding SearchResults.Count, Converter={StaticResource CountToBoolConverter}}"/>
            </Grid>
        </Frame>

        <!-- 日期范围筛选（可选） -->
        <VerticalStackLayout Grid.Row="0" VerticalOptions="End" Margin="10,0,10,60" HorizontalOptions="End">
            <Button Text="📅 日期范围" 
                    Clicked="OnDateFilterClicked"
                    BackgroundColor="Transparent"
                    TextColor="#007AFF"
                    BorderColor="#007AFF"
                    BorderWidth="1"
                    Padding="15,8"
                    FontSize="14"/>
        </VerticalStackLayout>

        <!-- 搜索结果和历史 -->
        <Grid Grid.Row="1" RowDefinitions="Auto,*">
            <!-- 搜索历史区域 -->
            <VerticalStackLayout Grid.Row="0" 
                                 IsVisible="{Binding ShowHistory}"
                                 Padding="15,10"
                                 Spacing="10">
                <HorizontalStackLayout HorizontalOptions="SpaceBetween">
                    <Label Text="最近搜索" 
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="#666666"/>
                    <Button Text="清空历史"
                            BackgroundColor="Transparent"
                            TextColor="#FF3B30"
                            FontSize="12"
                            Padding="10,5"
                            Command="{Binding ClearHistoryCommand}"/>
                </HorizontalStackLayout>
                
                <CollectionView ItemsSource="{Binding SearchHistory}"
                                SelectionMode="Single"
                                SelectedItem="{Binding SelectedHistoryItem, Mode=TwoWay}"
                                SelectionChangedCommand="{Binding SelectHistoryCommand}"
                                HeightRequest="200">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <ContentView Padding="10,5">
                                <Frame Padding="15" 
                                       Margin="0,3" 
                                       HasShadow="False" 
                                       BorderColor="#E0E0E0"
                                       BackgroundColor="#F8F8F8">
                                    <HorizontalStackLayout Spacing="10">
                                        <Label Text="🔍" FontSize="16"/>
                                        <VerticalStackLayout>
                                            <Label Text="{Binding Query}" 
                                                   FontSize="15"
                                                   TextColor="#333333"/>
                                            <Label Text="{Binding DisplayText}" 
                                                   FontSize="12"
                                                   TextColor="#999999"/>
                                        </VerticalStackLayout>
                                    </HorizontalStackLayout>
                                </Frame>
                            </ContentView>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
            
            <!-- 搜索结果区域 -->
            <CollectionView Grid.Row="1"
                            ItemsSource="{Binding SearchResults}"
                            SelectionMode="None"
                            Margin="10"
                            IsVisible="{Binding ShowHistory, Converter={StaticResource InverseBoolConverter}}">
            
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <ContentView>
                        <Frame Padding="15" Margin="0,5" HasShadow="False">
                            <VerticalStackLayout Spacing="8">
                                <HorizontalStackLayout Spacing="10">
                                    <Label Text="{Binding CreatedAt, StringFormat='{0:MM-dd HH:mm}'}" 
                                           FontSize="12" 
                                           TextColor="Gray"/>
                                    <Label Text="{Binding DurationSeconds, StringFormat='{0:mm\\:ss}'}" 
                                           FontSize="12" 
                                           TextColor="Gray"/>
                                </HorizontalStackLayout>
                                
                                <Label FontSize="15"
                                       LineBreakMode="WordWrap">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding TranscribedText}"/>
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                            </VerticalStackLayout>
                        </Frame>
                    </ContentView>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="15">
                    <Label Text="🔍" FontSize="64" HorizontalOptions="Center"/>
                    <Label Text="{Binding SearchHint}" 
                           FontSize="16" 
                           TextColor="Gray"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </CollectionView.EmptyView>
        </CollectionView>

        <!-- 加载中指示器 -->
        <ActivityIndicator Grid.Row="1"
                           IsRunning="{Binding IsSearching}"
                           IsVisible="{Binding IsSearching}"
                           Color="#007AFF"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
    </Grid>
</ContentPage>
