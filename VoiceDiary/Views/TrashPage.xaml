<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VoiceDiary.Views.TrashPage"
             Title="回收站">

    <Grid>
        <CollectionView ItemsSource="{Binding DeletedEntries}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <SwipeView>
                        <SwipeView.RightItems>
                            <SwipeItems>
                                <SwipeItem Text="恢复" 
                                           BackgroundColor="Green"
                                           CommandParameter="{Binding .}"
                                           Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.RecoverEntryCommand}"/>
                                <SwipeItem Text="永久删除" 
                                           BackgroundColor="Red"
                                           CommandParameter="{Binding .}"
                                           Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.HardDeleteEntryCommand}"/>
                            </SwipeItems>
                        </SwipeView.RightItems>
                        
                        <ContentView Padding="15,10">
                            <VerticalStackLayout Spacing="5">
                                <Label Text="{Binding TranscribedText}" 
                                       MaxLines="3"
                                       LineBreakMode="TailTruncation"
                                       FontSize="16"/>
                                <Label Text="{Binding DeletedAt, StringFormat='删除于：{0:MM-dd HH:mm}'}" 
                                       FontSize="12" 
                                       TextColor="Gray"/>
                            </VerticalStackLayout>
                        </ContentView>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            
            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10">
                    <Label Text="🗑️" FontSize="48" HorizontalOptions="Center"/>
                    <Label Text="回收站为空" FontSize="16" TextColor="Gray" HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </CollectionView.EmptyView>
        </CollectionView>

        <VerticalStackLayout HorizontalOptions="Center" 
                             VerticalOptions="End" 
                             Spacing="15"
                             Margin="20">
            <Button Text="恢复全部" 
                    Command="{Binding RecoverAllCommand}"
                    BackgroundColor="#4CAF50"
                    WidthRequest="200"/>
            <Button Text="清空回收站" 
                    Command="{Binding DeleteAllCommand}"
                    BackgroundColor="#F44336"
                    WidthRequest="200"/>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
