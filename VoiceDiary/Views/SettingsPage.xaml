<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VoiceDiary.Views.SettingsPage"
             Title="设置">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">
            
            <Label Text="🔒 隐私" FontSize="18" FontAttributes="Bold"/>
            
            <Frame BackgroundColor="#F8F8F8" Padding="15" HasShadow="False">
                <VerticalStackLayout Spacing="10">
                    <HorizontalStackLayout HorizontalOptions="SpaceBetween">
                        <Label Text="应用锁" VerticalOptions="Center"/>
                        <Label Text="管理安全设置 →" 
                               TextColor="#007AFF"
                               VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSecuritySettingsTapped"/>
                            </Label.GestureRecognizers>
                        </Label>
                    </HorizontalStackLayout>
                    <Label Text="启用生物识别保护隐私数据"
                           FontSize="12"
                           TextColor="#999999"/>
                </VerticalStackLayout>
            </Frame>

            <BoxView HeightRequest="1" BackgroundColor="#CCCCCC" Margin="0,10"/>

            <Label Text="💾 存储" FontSize="18" FontAttributes="Bold"/>
            
            <Label Text="{Binding StorageInfo}" FontSize="14"/>

            <HorizontalStackLayout Spacing="10">
                <Button Text="立即备份" 
                        Command="{Binding BackupCommand}"
                        BackgroundColor="#007AFF"
                        WidthRequest="130"/>
                <Button Text="恢复备份" 
                        Command="{Binding RestoreBackupCommand}"
                        BackgroundColor="#5856D6"
                        WidthRequest="130"/>
            </HorizontalStackLayout>

            <BoxView HeightRequest="1" BackgroundColor="#CCCCCC" Margin="0,10"/>

            <Label Text="🎙️ 快捷录音" FontSize="18" FontAttributes="Bold"/>
            
            <Frame BackgroundColor="#F8F8F8" Padding="15" HasShadow="False">
                <VerticalStackLayout Spacing="10">
                    <HorizontalStackLayout HorizontalOptions="SpaceBetween">
                        <Label Text="快捷录音设置" VerticalOptions="Center"/>
                        <Label Text="查看详情 →" 
                               TextColor="#007AFF"
                               VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnQuickRecordSettingsTapped"/>
                            </Label.GestureRecognizers>
                        </Label>
                    </HorizontalStackLayout>
                    <Label Text="桌面小组件、通知栏、耳机触发"
                           FontSize="12"
                           TextColor="#999999"/>
                </VerticalStackLayout>
            </Frame>

            <BoxView HeightRequest="1" BackgroundColor="#CCCCCC" Margin="0,10"/>

            <Label Text="ℹ️ 关于" FontSize="18" FontAttributes="Bold"/>
            
            <HorizontalStackLayout>
                <Label Text="版本" VerticalOptions="Center" WidthRequest="150"/>
                <Label Text="v1.0.0" VerticalOptions="Center"/>
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
