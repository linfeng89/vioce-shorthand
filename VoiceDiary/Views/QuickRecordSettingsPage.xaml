<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VoiceDiary.Views.QuickRecordSettingsPage"
             Title="快捷录音设置">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">
            
            <!-- 说明 -->
            <Frame BackgroundColor="#F8F8F8" Padding="15" HasShadow="False">
                <Label Text="快捷录音功能允许您在不打开应用的情况下快速开始录音，不错过任何重要灵感。"
                       FontSize="13"
                       TextColor="#666666"
                       LineBreakMode="WordWrap"/>
            </Frame>
            
            <!-- Android Widget -->
            <VerticalStackLayout Spacing="10">
                <Label Text="📱 桌面小组件 (Android)"
                       FontSize="16"
                       FontAttributes="Bold"/>
                
                <Label Text="将录音小组件添加到桌面，点击即可开始录音。"
                       FontSize="13"
                       TextColor="#666666"/>
                
                <Frame BorderColor="#E0E0E0" Padding="15" HasShadow="False" Margin="0,5,0,0">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="设置步骤："
                               FontSize="13"
                               FontAttributes="Bold"/>
                        <Label Text="1. 桌面空白处长按"
                               FontSize="12"/>
                        <Label Text="2. 选择「小组件」"
                               FontSize="12"/>
                        <Label Text="3. 找到「VoiceDiary 快速录音」"
                               FontSize="12"/>
                        <Label Text="4. 拖动到桌面空白位置"
                               FontSize="12"/>
                    </VerticalStackLayout>
                </Frame>
            </VerticalStackLayout>
            
            <BoxView HeightRequest="1" 
                     BackgroundColor="#E0E0E0"
                     HorizontalOptions="Fill"/>
            
            <!-- iOS Widget -->
            <VerticalStackLayout Spacing="10">
                <Label Text="🍎 小组件 (iOS)"
                       FontSize="16"
                       FontAttributes="Bold"/>
                
                <Label Text="在 iOS 主屏幕添加小组件，快速启动录音。"
                       FontSize="13"
                       TextColor="#666666"/>
                
                <Frame BorderColor="#E0E0E0" Padding="15" HasShadow="False" Margin="0,5,0,0">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="设置步骤："
                               FontSize="13"
                               FontAttributes="Bold"/>
                        <Label Text="1. 主屏幕空白处长按"
                               FontSize="12"/>
                        <Label Text="2. 点击左上角「+」按钮"
                               FontSize="12"/>
                        <Label Text="3. 搜索「VoiceDiary」"
                               FontSize="12"/>
                        <Label Text="4. 选择「快速录音」小组件"
                               FontSize="12"/>
                        <Label Text="5. 点击「添加小组件」"
                               FontSize="12"/>
                    </VerticalStackLayout>
                </Frame>
            </VerticalStackLayout>
            
            <BoxView HeightRequest="1" 
                     BackgroundColor="#E0E0E0"
                     HorizontalOptions="Fill"/>
            
            <!-- 通知栏快捷按钮 -->
            <VerticalStackLayout Spacing="10">
                <Label Text="🔔 通知栏快捷按钮"
                       FontSize="16"
                       FontAttributes="Bold"/>
                
                <Label Text="录音时通知栏会显示控制按钮，可随时停止录音。"
                       FontSize="13"
                       TextColor="#666666"/>
                
                <Label Text="✅ 录音过程中通知栏常驻"
                       FontSize="12"
                       TextColor="#00C853"/>
                <Label Text="✅ 显示录音时长"
                       FontSize="12"
                       TextColor="#00C853"/>
                <Label Text="✅ 一键停止录音"
                       FontSize="12"
                       TextColor="#00C853"/>
            </VerticalStackLayout>
            
            <BoxView HeightRequest="1" 
                     BackgroundColor="#E0E0E0"
                     HorizontalOptions="Fill"/>
            
            <!-- 耳机双击触发 (Android) -->
            <VerticalStackLayout Spacing="10">
                <HorizontalStackLayout HorizontalOptions="SpaceBetween">
                    <Label Text="🎧 耳机双击触发 (Android)"
                           FontSize="16"
                           FontAttributes="Bold"/>
                    <Switch IsEnabled="False"
                            IsVisible="False"
                            HorizontalOptions="End"/>
                </HorizontalStackLayout>
                
                <Label Text="双击耳机线控按钮快速启动录音。"
                       FontSize="13"
                       TextColor="#666666"/>
                
                <Frame BackgroundColor="#FFF3CD" 
                       Padding="10" 
                       HasShadow="False"
                       BorderColor="#FFC107"
                       Margin="0,5,0,0">
                    <VerticalStackLayout Spacing="3">
                        <Label Text="⚠️ 说明"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="#856404"/>
                        <Label Text="• 需要有线耳机或支持线控的蓝牙耳机"
                               FontSize="11"
                               TextColor="#856404"/>
                        <Label Text="• 部分耳机型号可能不兼容"
                               FontSize="11"
                               TextColor="#856404"/>
                    </VerticalStackLayout>
                </Frame>
            </VerticalStackLayout>
            
            <BoxView HeightRequest="1" 
                     BackgroundColor="#E0E0E0"
                     HorizontalOptions="Fill"/>
            
            <!-- 快捷录音优势 -->
            <Frame BackgroundColor="#E3F2FD" 
                   Padding="15" 
                   HasShadow="False"
                   BorderColor="#2196F3"
                   Margin="0,10,0,0">
                <VerticalStackLayout Spacing="8">
                    <Label Text="💡 快捷录音优势"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="#0D47A1"/>
                    <Label Text="✓ 无需解锁手机"
                           FontSize="12"
                           TextColor="#01579B"/>
                    <Label Text="✓ 无需打开应用"
                           FontSize="12"
                           TextColor="#01579B"/>
                    <Label Text="✓ 无需验证身份（快捷入口免验证）"
                           FontSize="12"
                           TextColor="#01579B"/>
                    <Label Text="✓ 录音后自动转写保存"
                           FontSize="12"
                           TextColor="#01579B"/>
                </VerticalStackLayout>
            </Frame>
            
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
